<header class="site-header">
  <nav id="navbar" class="navbar navbar-light navbar-expand-md" aria-label="Primary navigation">
    <div class="container site-header-inner">
      <a class="navbar-brand site-identity" href="{{ '/home/' | relative_url }}">
        <span class="site-name">
          {% if site.title == 'blank' %}
            {{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </span>
        <span class="site-tagline">{{ site.tagline }}</span>
      </a>

      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              <li class="nav-item {% if page.url == p.url %}active{% endif %}">
                <a class="nav-link" href="{{ p.url | relative_url }}">
                  {{ p.title }}
                  {% if page.url == p.url %}<span class="sr-only">(current)</span>{% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </nav>
</header>
