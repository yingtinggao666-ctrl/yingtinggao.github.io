{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% capture page_title %}{% if page.url == '/' %}{{ author_name }}{% else %}{{ page.title }} | {{ author_name }}{% endif %}{% endcapture %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>{{ page_title | strip }}</title>
<meta name="author" content="{{ author_name | strip }}">
<meta name="description" content="{{ page.description | default: site.description | strip }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{{ page.keywords | default: site.keywords }}">
{% endif %}
{% if site.serve_og_meta %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ page_title | strip }}">
  <meta property="og:url" content="{{ page.url | absolute_url }}">
  <meta property="og:description" content="{{ page.description | default: site.description | strip }}">
  {% if page.og_image or site.og_image %}<meta property="og:image" content="{{ page.og_image | default: site.og_image | absolute_url }}">{% endif %}
{% endif %}
