<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>
  <body class="reference-site sticky-bottom-footer">
    {% include reference-header.liquid %}
    <div class="container site-main" role="main">
      {{ content }}
    </div>
    {% include footer.liquid %}
    <script defer src="{{ '/assets/js/navigation.min.js' | relative_url }}"></script>
    {% if page.gallery_sets %}<script defer src="{{ '/assets/js/project-gallery.min.js' | relative_url }}"></script>{% endif %}
  </body>
</html>
