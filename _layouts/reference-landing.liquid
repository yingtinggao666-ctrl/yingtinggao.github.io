<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/landing.css' | relative_url }}">
  </head>
  <body class="landing-page">
    <main class="welcome" aria-labelledby="welcome-title">
      <section class="composition">
        <div class="keywords" aria-label="Research keywords">
          <span class="keyword keyword--core" style="--x: 24%; --y: 24%; --size: 1.22rem; --tone: 0.74;">Biomaterials</span>
          <span class="keyword keyword--core" style="--x: 80%; --y: 50%; --size: 1.08rem; --tone: 0.7;">HCI</span>
          <span class="keyword keyword--core" style="--x: 55%; --y: 9%; --size: 1.16rem; --tone: 0.68;">Ecology</span>
          <span class="keyword" style="--x: 83%; --y: 27%; --size: 1.18rem; --tone: 0.54;">Material-Driven Design</span>
          <span class="keyword" style="--x: 25%; --y: 65%; --size: 1.06rem; --tone: 0.5;">Growing Materials</span>
          <span class="keyword" style="--x: 18%; --y: 39%; --size: 0.92rem; --tone: 0.42;">Biofabrication</span>
          <span class="keyword" style="--x: 82%; --y: 39%; --size: 0.88rem; --tone: 0.4;">Responsive Materials</span>
          <span class="keyword" style="--x: 21%; --y: 52%; --size: 0.78rem; --tone: 0.34;">Ecological Reflection</span>
          <span class="keyword" style="--x: 84%; --y: 60%; --size: 0.94rem; --tone: 0.39;">Participatory Design</span>
          <span class="keyword" style="--x: 38%; --y: 13%; --size: 0.82rem; --tone: 0.36;">Biodegradable Interfaces</span>
          <span class="keyword" style="--x: 68%; --y: 19%; --size: 0.84rem; --tone: 0.36;">Sustainable HCI</span>
          <span class="keyword keyword--low" style="--x: 27%; --y: 78%; --size: 0.66rem; --tone: 0.22;">Loofah Wearables</span>
          <span class="keyword keyword--low" style="--x: 75%; --y: 78%; --size: 0.66rem; --tone: 0.22;">Soft Actuation</span>
          <span class="keyword keyword--low" style="--x: 43%; --y: 86%; --size: 0.64rem; --tone: 0.2;">Recyclable Electronics</span>
          <span class="keyword keyword--low" style="--x: 58%; --y: 82%; --size: 0.62rem; --tone: 0.2;">Community-Based Studies</span>
          <span class="keyword keyword--low" style="--x: 76%; --y: 69%; --size: 0.62rem; --tone: 0.24;">Design Tools</span>
        </div>

        <div class="identity">
          <h1 id="welcome-title" aria-label="{{ page.name }}">
            <img
              class="name-lockup"
              src="{{ '/assets/img/yingting-gao-wordmark.svg' | relative_url }}"
              width="2616"
              height="931"
              alt=""
              aria-hidden="true"
            >
          </h1>
          <p class="direction">{{ page.introduction }}</p>
          <a class="more" href="{{ page.button_url | relative_url }}">{{ page.button_label }}</a>
        </div>
      </section>
    </main>
  </body>
</html>
